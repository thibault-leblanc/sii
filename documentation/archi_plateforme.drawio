        <mxCell id="cib-flux" value="&lt;b&gt;Flux entre zones (source → destination)&lt;/b&gt;&lt;br&gt;① 20 interne, non routé : automate → simulateur&lt;br&gt;② 40 → 30 : SCADA → automate&lt;br&gt;③ 40 → 30 : passerelle → automate&lt;br&gt;④ 40 → 50 : passerelle → broker" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="20" y="718" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="cib-flux2" value="&lt;br&gt;⑤ 60 → 40 : terminal → SCADA&lt;br&gt;⑥ 60 → 50 : terminal → tableaux de bord&lt;br&gt;⑦ 70 → 10 : Ansible → machines (pi51 par son adresse 10)&lt;br&gt;⑧ sas → 10 : SSH, administration commutateur et pare-feu&lt;br&gt;⑨ sas → 70 : git, registre, NetBox&lt;br&gt;Sans terminaux : sas → IHM en 40 et 50" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="370" y="718" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="cib-legende" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;Cadre plein : existe (parfois à déplacer)&lt;br&gt;Tirets : à créer (zone, composant ou flux)&lt;br&gt;&lt;font color=&quot;#d32f2f&quot;&gt;Pointillés rouges : écart à résorber&lt;/font&gt;&lt;br&gt;Tout flux absent est à interdire en fin de chantier&lt;br&gt;Zones inspirées d&#x27;ISA-95 et IEC 62443, sans conformité revendiquée" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="780" y="718" width="370" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
