    "ha-cluster": {
      "type": "conteneur_docker",
      "nom": "ha-cluster",
      "fonction": "Agent de haute disponibilité (keepalived), réseau de l'hôte",
      "cluster": "fonctionnel",
      "hote_parent": [
        "pi31",
        "pi32"
