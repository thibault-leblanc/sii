  "ressources_logiques": {
    "api-rincage": {
      "type": "conteneur_docker",
      "nom": "api-rincage",
      "fonction": "Automate de contrôle et serveur OPC-UA",
      "cluster": "fonctionnel",
      "hote_parent": [
        "pi31",
        "pi32"
      ],
      "haute_disponibilite": true,
      "depot_source": "https://github.com/thibault-leblanc/sii/tree/main/configurations/conteneurs/api/rincage",
      "chemin_deploiement": "api/rincage",
      "interfaces": {
        "vlan20": {
          "type": "macvlan",
          "vlan_id": "VLAN20",
          "ip_statique": "192.168.20.20"
        },
        "vlan30": {
          "type": "macvlan",
          "vlan_id": "VLAN30",
          "ip_statique": "192.168.30.20"
        }
      },
      "passerelle": "vlan30",
      "ports": {
        "opcua": {
          "proto": "tcp",
          "ports": [
            4840
          ],
          "ip": "192.168.30.20/24",
          "clients": [
            "poste-admin",
            "scada"
          ]
        }
      },
      "fichiers": {
        "config_api.json": "configurations/conteneurs/api/rincage/config_api.json"
      },
      "compose": {
        "image": "api-rincage-image:latest",
        "restart": "no",
        "service": "api_rincage",
        "volumes": [
          "./config_api.json:/app/config_api.json"
        ],
        "container_name": "api-rincage"
      }
    },
    "donnees-vlan-20": {
      "type": "conteneur_docker",
      "nom": "donnees-vlan-20",
      "fonction": "Serveur FTP, ingestion du réseau terrain",
      "cluster": "infra",
      "hote_parent": [
        "pi51"
      ],
      "haute_disponibilite": false,
      "depot_source": "https://github.com/thibault-leblanc/sii/tree/main/configurations/conteneurs/donnees/serveur",
      "chemin_deploiement": "donnees-vlan-20",
      "interfaces": {
        "vlan20": {
          "type": "macvlan",
          "vlan_id": "VLAN20",
          "ip_statique": "192.168.20.30"
        }
      },
      "ports": {
        "ftp": {
          "proto": "tcp",
          "ports": [
            21,
            "21000-21010"
          ]
        }
      },
      "compose": {
        "image": "serveur-ftp:latest",
        "restart": "unless-stopped",
        "service": "donnees-vlan-20",
        "volumes": [
          "/home/pi51/donnees/vlan20:/partage"
        ],
        "environment": [
          "FTP_USER=admin",
          "FTP_PASS=${FTP_PASS:?definir FTP_PASS dans .env}"
        ],
        "container_name": "donnees-vlan-20"
